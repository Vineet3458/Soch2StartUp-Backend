# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CLIENT_URL=http://localhost:5173
# Set to "true" to let this server also serve the built frontend (npm run build in the frontend first)
SERVE_CLIENT=false

# ── Database ─────────────────────────────────────────────
# Local MongoDB or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/soch2startup

# ── Security ─────────────────────────────────────────────
# REQUIRED in production. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=

# ── AI (optional) ────────────────────────────────────────
# Without a key the platform uses its built-in demo analysis. Get a key at https://aistudio.google.com
GEMINI_API_KEY=

# Multi-model council (recommended): ONE key gives access to GPT, Claude,
# Gemini and Llama. Free signup / free model quota at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Live web data. The collector works with NO key (Google News RSS + site scraping).
# These optional keys make search cleaner and more reliable.
TAVILY_API_KEY=
SERPER_API_KEY=
