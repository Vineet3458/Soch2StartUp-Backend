PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/soch2startup
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Leave GEMINI_API_KEY empty to use the built-in demo analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Used by "npm run seed" to create the first superadmin
SUPERADMIN_EMAIL=superadmin@soch2startup.com
SUPERADMIN_PASSWORD=Admin@12345
