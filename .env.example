# ── Backend Environment Configuration ───────────────────────

# Server & Runtime (Render injects PORT automatically, defaults to 10000)
PORT=5000
NODE_ENV=production

# Allowed Frontend Origins:
# Put your Vercel deployment URL here (comma-separated if multiple)
# Example: https://soch2startup.vercel.app,http://localhost:5173
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Set to "true" to automatically allow all *.vercel.app preview branches
ALLOW_VERCEL_PREVIEWS=true

# Keep false when frontend is hosted separately on Vercel
SERVE_CLIENT=false

# ── Database ─────────────────────────────────────────────────
# MongoDB Atlas Connection String (REQUIRED for Render deployment)
# Get a free cluster at https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/soch2startup?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/soch2startup?retryWrites=true&w=majority

# ── Authentication & Security ────────────────────────────────
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate-a-strong-secret-key-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# ── AI Evaluator & Search APIs (Optional) ────────────────────
# Without keys, the platform operates in built-in deterministic demo mode.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
